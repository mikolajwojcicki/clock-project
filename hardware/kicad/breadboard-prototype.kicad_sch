	(polyline (pts (xy 15.24 158.75) (xy 281.94 158.75) (xy 281.94 198.12) (xy 15.24 198.12) (xy 15.24 158.75)) (stroke (width 0.254) (type default)) (fill (type none)) (uuid "5121804d-3afb-4061-8d64-c9daa3feaa27"))
	(text "PROTOTYPE SAFETY & INTEGRATION RULES" (at 17.78 163.83 0) (effects (font (size 1.778 1.778) (bold yes)) (justify left bottom)) (uuid "23f75a80-5902-44ad-9106-b8e03c1f4648"))
	(text "1. POWER: Feed the 3V3 rail only from DK header P1 pin VDD (USB powered). Never use 5V, External supply, VDD_nRF or P22. NEVER connect KORAD bench supply and the 3V3 rail together!" (at 17.78 168.91 0) (effects (font (size 1.2 1.2)) (justify left bottom)) (uuid "fdd94c6f-31c2-4d4d-9bf5-0bd799128387"))
	(text "2. SAFE CONTROL STATES: Set DCF_PON HIGH (disabled, 0.0uA). Set EPD_CS and SENSOR_CS HIGH (unselected). Set BUZZER_EN LOW (off)." (at 17.78 173.99 0) (effects (font (size 1.2 1.2)) (justify left bottom)) (uuid "7869e95b-1783-4ce1-92ff-d35d3a010c98"))
	(text "3. DCF-77 VERIFICATION: Measure DCF OUT high-level voltage before connecting to DK P0.25. Orient antenna perpendicular to Frankfurt." (at 17.78 179.07 0) (effects (font (size 1.2 1.2)) (justify left bottom)) (uuid "c8c1470c-921a-4ed9-aab2-904bc70a3cd8"))
	(text "4. E-PAPER CONFIGURATION: Verify switch BS1 = 0 on back of Waveshare HAT for 4-wire SPI mode before powering display rail." (at 17.78 184.15 0) (effects (font (size 1.2 1.2)) (justify left bottom)) (uuid "58136a6a-a20b-476d-9bef-479ca226269f"))
	(text "5. BUZZER DRIVER: Verify 2N3904 TO-92 pinout (1=Emitter, 2=Base, 3=Collector). Diode D1 cathode connects to +3V3 to clamp flyback spikes." (at 17.78 189.23 0) (effects (font (size 1.2 1.2)) (justify left bottom)) (uuid "09b03afe-d82b-40bf-a0c2-c5e6952717c8"))
	(text "6. STAGED BRING-UP: 1) DK Blinky -> 2) E-Paper Demo -> 3) LIS3DH WHO_AM_I -> 4) DCF Standalone -> 5) DCF Sync -> 6) Buzzer Alarm." (at 17.78 194.31 0) (effects (font (size 1.2 1.2)) (justify left bottom)) (uuid "6fe3d344-da24-4316-963b-27008cf1f574"))
