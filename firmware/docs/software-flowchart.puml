' Source for firmware/docs/software-flowchart.svg and .pdf.
' Render SVG with PlantUML, then PDF from that SVG (keeps Polish letters):
' plantuml -tsvg -charset UTF-8 software-flowchart.puml
' rsvg-convert -f pdf -o software-flowchart.pdf software-flowchart.svg
@startuml
skinparam monochrome true
skinparam shadowing false
skinparam backgroundColor white
skinparam defaultFontName DejaVu Serif
skinparam activityFontName DejaVu Serif
skinparam activityDiamondFontName DejaVu Serif
skinparam noteFontName DejaVu Serif
skinparam dpi 160
skinparam ActivityBorderColor black
skinparam ActivityDiamondBorderColor black
skinparam ArrowColor black

start
:Inicjalizacja zegarów, GPIO i przerwań;
repeat
  :Sprawdź, co jest do zrobienia\n(procedury obsługi zegara, alarmu, DCF i UART);

  if (Upłynęła sekunda?) then (tak)
    :Zwiększ czas o 1 s;
    if (Zmieniła się minuta?) then (tak)
      if (Dla tego dnia tygodnia\nalarm jest włączony\ni godzina się zgadza?) then (tak)
        :Włącz brzęczyk i LIS3DH;
      else (nie)
      endif
    else (nie)
    endif
  else (nie)
  endif

  if (Alarm trwa?) then (tak)
    if (Przycisk albo licznik ruchu\nosiągnął próg?) then (tak)
      :Wyłącz brzęczyk i LIS3DH;
    else (nie)
      :Zmień fazę brzęczyka\nwedług terminu RTC1;
    endif
  else (nie)
  endif

  if (Okno synchronizacji DCF?) then (tak)
    :Włącz zasilanie odbiornika (PON);
    :Zbieraj zbocza DCF_OUT i złóż ramkę minutową;
    if (Parzystość i znaczniki minuty\nsą poprawne?) then (tak)
      :Skoryguj RTC o różnicę ramki;
    else (nie)
      :Zostaw RTC bez zmian.\nZapisz przyczynę odrzucenia;
    endif
    :Po zakończeniu okna wyłącz odbiornik (PON);
  else (nie)
  endif

  if (Zmienił się czas lub alarm\ni okno DCF jest zamknięte?) then (tak)
    :Odśwież e-paper.\nCzekanie na BUSY w WFE, potem głęboki sen panelu;
  else (nie)
    :Ustaw najbliższy termin RTC1\n(sekunda, brzęczyk, koniec okna DCF);
    :Sen (WFE).\nDCF wyłączony, e-paper i LIS3DH bez zasilania;
    note right
      Przerwania budzące CPU:
      RTC1 COMPARE (termin),
      GPIOTE PORT (przyciski),
      GPIOTE IN (INT1, DCF_OUT, EPD_BUSY),
      UARTE RX (tylko wersja z konsolą)
    end note
  endif
repeat while (Zasilanie jest) is (tak)
stop
@enduml
