' L2 modules, part A: interrupt sources and the order of main-loop steps in main.c (app_poll).
' Derived from firmware/apps/clock/src/main.c and firmware/src/*.c; see README.md (fact table).
' Left: interrupts (ISR, flags only); right: app_poll() steps in call order, then draw or sleep.
' Arrows: solid = order of calls, dashed = flag set in an interrupt and read in the loop.
' Other L2 parts: l2-modules-b ... e. Render: README.md, section Render.
@startuml
top to bottom direction
skinparam monochrome true
skinparam shadowing false
skinparam backgroundColor white
skinparam defaultFontName DejaVu Serif
skinparam dpi 160
skinparam ArrowColor black
skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam nodesep 30
skinparam ranksep 50

component "UARTE0: FIFO" as irq_uart
component "RTC1: rtc_evt" as irq_rtc
component "GPIOTE: on_button,\non_int1, on_edge (DCF_OUT)" as irq_gpiote
component "SWI2 (SoftDevice):\non_ble_evt, qwr_cb" as irq_sd

component "1. poll_uart" as p_uart
component "2. poll_clock" as p_clock
component "3. poll_alarm" as p_alarm
component "4. poll_dcf" as p_dcf
component "5. poll_ble" as p_ble
component "6. arm_wake" as p_wake
component "main(): draw()\nalbo board_sleep()" as main
component "board\nRTC1, board_ms,\nsen WFE, przyciski" as m_board

p_uart -down-> p_clock
p_clock -down-> p_alarm
p_alarm -down-> p_dcf
p_dcf -down-> p_ble
p_ble -down-> p_wake
p_wake -down-> main
main -down-> m_board

irq_uart -[hidden]down-> irq_rtc
irq_rtc -[hidden]down-> irq_gpiote
irq_gpiote -[hidden]down-> irq_sd

irq_uart .right.> p_uart
irq_rtc .right.> p_clock
irq_gpiote .right.> p_alarm
irq_sd .right.> p_ble
@enduml
