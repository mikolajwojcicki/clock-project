' L2 modules, part B: alarm and motion dismiss (poll_alarm) and the hardware it drives.
' Derived from firmware/apps/clock/src/main.c and firmware/src/*.c; see README.md (fact table).
' Arrows: solid = function call, dashed = flag set in an interrupt and read in the loop.
' Other L2 parts: l2-modules-a, c ... e. Render: README.md, section Render.
@startuml
top to bottom direction
skinparam monochrome true
skinparam shadowing false
skinparam backgroundColor white
skinparam defaultFontName DejaVu Serif
skinparam dpi 160
skinparam ArrowColor black
skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam nodesep 30
skinparam ranksep 50

component "GPIOTE: on_button, on_int1" as irq_gpiote
component "3. poll_alarm" as p_alarm

component "alarm\ntabela 7×8,\n1 s / 1 s, 60 s" as m_alarm
component "motion_count\n20 zdarzeń w 30 s" as m_motion
component "lis3dh\nrejestry, INT1" as m_lis
component "buzzer\nPWM0 2,7 kHz" as m_buzz
component "spi_bus\nSPIM0" as m_spi
component "LIS3DH" as hw_lis
component "Brzęczyk" as hw_buzz

irq_gpiote .down.> p_alarm
p_alarm -down-> m_alarm
p_alarm -down-> m_motion
p_alarm -down-> m_lis
p_alarm -down-> m_buzz
m_lis -down-> m_spi
m_spi -down-> hw_lis
m_buzz -down-> hw_buzz
@enduml
