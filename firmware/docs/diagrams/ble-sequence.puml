' BLE sequence: advertising window, connect, schedule read, schedule write (short and long), disconnect.
' Message order follows firmware/src/ble_sched.c (on_ble_evt, on_authorize, qwr_cb, ble_sched_poll),
' SDK nrf_ble_gatt.c / nrf_ble_qwr.c, and web/app.js (connect, upload, onDisconnected).
' Render: README.md, section Render.
@startuml
skinparam monochrome true
skinparam shadowing false
skinparam backgroundColor white
skinparam defaultFontName DejaVu Serif
skinparam noteFontName DejaVu Serif
skinparam dpi 160
skinparam ArrowColor black
skinparam SequenceLifeLineBorderColor black
skinparam ParticipantBorderColor black
skinparam maxMessageSize 190
autonumber

participant "Strona WWW\n(app.js)" as Web
participant "Przeglądarka\ni BLE OS" as Br
participant "SoftDevice\nS112" as SD
participant "ble_sched.c\n(SWI2)" as Isr
participant "pętla główna\n(main.c)" as Loop
participant "alarm.c,\nsched_store.c" as Store

== Rozgłaszanie ==
Loop -> SD : przycisk 2 s, brak alarmu: sd_ble_gap_adv_start (100 ms, 60 s)
SD -> Br : ADV_IND „ShakeClock”, SCAN_RSP z UUID usługi

== Połączenie i odkrywanie ==
Web -> Br : „Connect”: requestDevice, wybór, gatt.connect()
Br -> SD : CONNECT_IND
SD -> Isr : BLE_GAP_EVT_CONNECTED → s_conn, s_ev_connect
SD <-> Br : wymiana ATT MTU (nrf_ble_gatt, do 247)
Loop -> Loop : ble_sched_poll: limit łącza 60 s
Web -> SD : getPrimaryService, getCharacteristic (SoftDevice odpowiada sam)

== Odczyt rozkładu ==
Web -> SD : readValue() → ATT Read Request
SD -> Isr : RW_AUTHORIZE_REQUEST (odczyt)
Isr -> Store : alarm_table_get()
Isr -> SD : sched_encode → sd_ble_gatts_rw_authorize_reply (113 B)
SD -> Web : ATT Read Response → decode(), tabela na ekranie

== Zapis rozkładu ==
Web -> Br : „Upload”: writeValueWithResponse(113 B)
alt ATT MTU ≥ 116
  Br -> SD : ATT Write Request
  SD -> Isr : RW_AUTHORIZE_REQUEST (WRITE_REQ)
  Isr -> Isr : validate → sched_decode
else ATT MTU < 116 (zapis długi)
  Br -> SD : ATT Prepare Write ×n → bufor nrf_ble_qwr (256 B)
  Br -> SD : ATT Execute Write
  SD -> Isr : RW_AUTHORIZE_REQUEST (EXEC_WRITE)
  Isr -> Isr : qwr_cb(AUTH_REQUEST): validate → sched_decode
end
Isr -> SD : sd_ble_gatts_rw_authorize_reply(status)
note right of Isr : OK → s_stage_ready = true:\nWRITE_REQ przed odpowiedzią,\nzapis długi w qwr_cb(EXECUTE_WRITE)\npo odpowiedzi
SD -> Web : ATT Write Response albo błąd (0x0D, 0x82–0x84, 0x90)
Loop -> Store : ble_sched_poll: alarm_table_replace, sched_store_save
Store -> SD : nrf_fstorage: kasowanie i zapis strony 0x7F000
Loop -> Loop : limit łącza 30 s od zapisu
Web -> SD : readValue() (jak w odczycie) → porównanie bajtów

== Rozłączenie ==
Loop -> SD : limit minął lub alarm → sd_ble_gap_disconnect
SD -> Br : LL_TERMINATE_IND
Br -> Web : gattserverdisconnected → „disconnected”
SD -> Isr : BLE_GAP_EVT_DISCONNECTED → s_ev_disconnect
note over SD, Isr : bez połączenia: po 60 s ADV_SET_TERMINATED → s_ev_adv_stop
@enduml
