{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "firmware: blinky build",
      "type": "shell",
      "command": "make",
      "options": {
        "cwd": "${workspaceFolder}/firmware/apps/blinky"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "firmware: blinky flash",
      "type": "shell",
      "command": "make flash ACM=${input:acmDevice}",
      "options": {
        "cwd": "${workspaceFolder}/firmware/apps/blinky"
      },
      "group": "none",
      "problemMatcher": []
    },
    {
      "label": "firmware: blinky clean",
      "type": "shell",
      "command": "make clean",
      "options": {
        "cwd": "${workspaceFolder}/firmware/apps/blinky"
      },
      "group": "none",
      "problemMatcher": []
    },
    {
      "label": "firmware: bringup build",
      "type": "shell",
      "command": "make",
      "options": {
        "cwd": "${workspaceFolder}/firmware/apps/bringup"
      },
      "group": "build",
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "firmware: bringup flash",
      "type": "shell",
      "command": "make flash ACM=${input:acmDevice}",
      "options": {
        "cwd": "${workspaceFolder}/firmware/apps/bringup"
      },
      "group": "none",
      "problemMatcher": []
    },
    {
      "label": "firmware: clock flash",
      "type": "shell",
      "command": "make flash ACM=${input:acmDevice}",
      "options": {
        "cwd": "${workspaceFolder}/firmware/apps/clock"
      },
      "group": "none",
      "problemMatcher": []
    },
    {
      "label": "firmware: clock flash no UART",
      "type": "shell",
      "command": "make SLEEP_UART=0 flash ACM=${input:acmDevice}",
      "options": {
        "cwd": "${workspaceFolder}/firmware/apps/clock"
      },
      "group": "none",
      "problemMatcher": []
    },
    {
      "label": "firmware: serial console",
      "type": "shell",
      "command": "picocom -b 115200 ${input:acmDevice}",
      "group": "none",
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "acmDevice",
      "type": "pickString",
      "description": "ACM device (J-Link DK = flash target; check /dev/serial/by-id)",
      "options": [
        "/dev/ttyACM0",
        "/dev/ttyACM1",
        "/dev/ttyACM2",
        "/dev/ttyACM3",
        "/dev/ttyACM4"
      ],
      "default": "/dev/ttyACM0"
    }
  ]
}
