{
  "$schema": "https://raw.githubusercontent.com/can1357/oh-my-pi/main/packages/coding-agent/src/config/mcp-schema.json",
  "mcpServers": {
    "Saleae Logic 2": {
      "url": "http://127.0.0.1:10530"
    },
    "overleaf": {
      "command": "uv",
      "args": [
        "--no-cache",
        "--directory",
        "/opt/repos/overleaf-mcp-server",
        "run",
        "python",
        "-m",
        "src.main"
      ]
    },
    "filesystem": {
      "enabled": false,
      "command": "npx",
      "args": [
        "-y",
        "--prefer-online",
        "--cache",
        "/tmp/empty-cache",
        "@modelcontextprotocol/server-filesystem",
        "/home/wenigz/clock-project/clock-project-latex"
      ]
    }
  }
}
